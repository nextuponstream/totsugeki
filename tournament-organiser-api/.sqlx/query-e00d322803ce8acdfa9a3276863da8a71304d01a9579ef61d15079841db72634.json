  "query": "\nSELECT\n    players.id,\n    user_id,\n    guest_id,\n    COALESCE (U.name, G.name, '') as name\nFROM players\nLEFT JOIN users U ON players.user_id = U.id\nLEFT JOIN guests G ON players.guest_id = G.id\nWHERE tournament_id = $1            \n            ",
